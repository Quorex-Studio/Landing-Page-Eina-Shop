</beauty-header-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp>

<script>
(function() {
  class BeautyHeaderaeexiehfiadzmdtnaaaigenblock06703d7q7rbpp extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.hamburger = this.querySelector('.ai-beauty-header__hamburger-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');
      this.mobileMenu = this.querySelector('.ai-beauty-header__mobile-menu-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');
      this.mobileClose = this.querySelector('.ai-beauty-header__mobile-close-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');
      this.overlay = this.querySelector('.ai-beauty-header__overlay-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');
      this.categoryBtns = this.querySelectorAll('.ai-beauty-header__mobile-category-btn-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');
      this.subcatBtns = this.querySelectorAll('.ai-beauty-header__mobile-subcat-btn-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');
      this.searchTriggers = this.querySelectorAll('.ai-beauty-header__search-trigger-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp, .ai-beauty-header__mobile-search-trigger-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');
      this.searchModal = this.querySelector('.ai-beauty-header__search-modal-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');
      this.searchClose = this.querySelector('.ai-beauty-header__search-close-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');
      this.searchInput = this.querySelector('.ai-beauty-header__search-input-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp');

      this.setupEventListeners();
    }

    setupEventListeners() {
      if (this.hamburger) {
        this.hamburger.addEventListener('click', () => this.openMobileMenu());
      }

      if (this.mobileClose) {
        this.mobileClose.addEventListener('click', () => this.closeMobileMenu());
      }

      if (this.overlay) {
        this.overlay.addEventListener('click', () => this.closeMobileMenu());
      }

      this.categoryBtns.forEach(btn => {
        btn.addEventListener('click', (e) => this.toggleCategory(e));
      });

      this.subcatBtns.forEach(btn => {
        btn.addEventListener('click', (e) => this.toggleSubcategory(e));
      });

      this.searchTriggers.forEach(trigger => {
        trigger.addEventListener('click', () => this.openSearch());
      });

      if (this.searchClose) {
        this.searchClose.addEventListener('click', () => this.closeSearch());
      }

      if (this.searchModal) {
        this.searchModal.addEventListener('click', (e) => {
          if (e.target === this.searchModal) {
            this.closeSearch();
          }
        });
      }
    }

    openMobileMenu() {
      this.mobileMenu.classList.add('active');
      this.overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    closeMobileMenu() {
      this.mobileMenu.classList.remove('active');
      this.overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    toggleCategory(e) {
      const btn = e.currentTarget;
      const categoryId = btn.getAttribute('data-category');
      const subcategory = this.querySelector(`[data-subcategory="${categoryId}"]`);
      
      btn.classList.toggle('active');
      if (subcategory) {
        subcategory.classList.toggle('active');
      }
    }

    toggleSubcategory(e) {
      const btn = e.currentTarget;
      const subcatId = btn.getAttribute('data-subcat');
      const sublinks = this.querySelector(`[data-sublinks="${subcatId}"]`);
      
      btn.classList.toggle('active');
      if (sublinks) {
        sublinks.classList.toggle('active');
      }
    }

    openSearch() {
      this.searchModal.classList.add('active');
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        if (this.searchInput) {
          this.searchInput.focus();
        }
      }, 100);
    }

    closeSearch() {
      this.searchModal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  customElements.define('beauty-header-aeexiehfiadzmdtnaaaigenblock06703d7q7rbpp', BeautyHeaderaeexiehfiadzmdtnaaaigenblock06703d7q7rbpp);
})();
</script>

</div>


