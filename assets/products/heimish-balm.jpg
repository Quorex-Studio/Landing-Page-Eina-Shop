            customer_mail: "My Mail",
            customer_phone: "My Phone",
            customer_message: "My Message",
            type_radio1: "Do You Need",
            type_radio2: "How would you like me to contact you?",
            mail: "consultancy@makeupstash.pk",
            subject: "Ask An Expert",
            label: "Makeupstash",
